{
  "name": "anuma-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" \"docs/phase-*-foundation.md\" \"docs/phase-3-audio-transcription.md\" \"*.{ts,mjs,json,md}\"",
    "format:write": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" \"docs/phase-*-foundation.md\" \"docs/phase-3-audio-transcription.md\" \"*.{ts,mjs,json,md}\"",
    "catalogue:load": "node --env-file=.env.local --experimental-strip-types --no-warnings=ExperimentalWarning scripts/load-catalogue.mts",
    "db:migrate": "node --env-file=.env.local --experimental-strip-types --no-warnings=ExperimentalWarning scripts/apply-migration.mts",
    "test": "vitest run",
    "test:security": "node tests/security/rls.integration.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.2",
    "ffmpeg-static": "^5.3.0",
    "music-metadata": "^11.14.0",
    "next": "^16.3.0",
    "openai": "^7.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sarvamai": "^1.1.8",
    "server-only": "^0.0.1",
    "workflow": "^4.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.3.0",
    "jsdom": "^30.0.1",
    "postgres": "^3.4.9",
    "prettier": "^3.9.6",
    "supabase": "^2.112.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@workflow/core": {
      "nanoid": "5.1.16"
    },
    "@workflow/world-local": {
      "undici": "7.29.0"
    },
    "@workflow/world-vercel": {
      "undici": "7.29.0"
    }
  }
}
