NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Canonical application origin. Production: https://anumaai-ten.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local migration and integration-test use only. Never prefix this with NEXT_PUBLIC_.
SUPABASE_DB_URL=

# Server-only runtime credentials. Do not expose or prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
SARVAM_API_KEY=

# Audio below this is never sent for transcription. Sarvam bills per second of
# audio submitted, and most short captures are not interactions at all.
# Which speech-to-text provider transcribes new recordings: sarvam | openai.
# Both are fully implemented; switching takes effect on the next run and needs
# no migration. Sarvam is the default on measured evidence: on a real 121s
# Hinglish call it cost Rs 1.53 against OpenAI's Rs 3.56 of billed tokens, and
# it read the budget, the locality and the unit type correctly where OpenAI did
# not. Per-minute prices quoted for OpenAI omit output tokens, which are ~90%
# of its real cost.
TRANSCRIPTION_PROVIDER=sarvam

TRANSCRIPTION_MIN_DURATION_MS=20000

# Strip silence before submitting to the provider. The stored original is never
# modified; a trimmed copy is sent and the timestamps are mapped back.
AUDIO_TRIM_ENABLED=true

# Playback rate applied after trimming. 1 = off. Speeding audio up is billed as
# less audio but degrades recognition, and digits degrade first. Do not raise
# this without measuring entity accuracy on real recordings.
AUDIO_TRIM_TEMPO=1

# Vercel Cron sends this as a bearer token to /api/cron/audio-retention, which
# deletes expired source audio. Without it the sweep refuses to run.
CRON_SECRET=
SARVAM_CALLBACK_TOKEN=
OPENAI_API_KEY=
ANUMA_ANALYSIS_MODEL=gpt-5.6-luna
